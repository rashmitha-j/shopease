# Base URL of the Express API, without a trailing slash or /api.
# Leave empty in development: Vite proxies /api to http://localhost:5000.
# On Vercel, leave it empty too: client/vercel.json rewrites /api to the Render server, so the
# refresh cookie stays first-party. Only set it (e.g. https://shopease-api.onrender.com) when the
# frontend calls the server directly without that rewrite.
VITE_API_URL=
