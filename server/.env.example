PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (Atlas → Connect → Drivers)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ecommerce

# Frontend URL (for CORS + cookies)
CLIENT_URL=http://localhost:5173

# Use long random strings. Generate one with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_me_with_a_long_random_string
JWT_REFRESH_SECRET=replace_me_with_a_different_long_random_string
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d

# Razorpay (optional: without these keys only cash on delivery is offered).
# Use TEST mode keys from dashboard.razorpay.com → Account & Settings → API Keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret: dashboard → Account & Settings → Webhooks → add
# https://<your-server>/api/payments/razorpay/webhook with events payment.captured,
# order.paid and payment.failed, and choose a secret. It is different from the key secret.
RAZORPAY_WEBHOOK_SECRET=

# Used only by `npm run seed:admin`
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe@123
